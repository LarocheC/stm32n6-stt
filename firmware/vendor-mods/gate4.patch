+ * so init_bm() calls it first when this is built. */
+static void beacon(char c)
+{
+  while ((USART1->ISR & USART_ISR_TXE_TXFNF) == 0U) { }
+  USART1->TDR = (uint32_t)(uint8_t)c;
+  while ((USART1->ISR & USART_ISR_TC) == 0U) { }
+}
+/* Hold each marker for ~2 s instead of emitting it once.
+ *
+ * Every negative result in this gate so far has been a timing artefact rather
+ * than a measurement: a one-shot marker emitted at boot lands inside the ~8 s
+ * usbipd re-attach gap and is simply not there to be read, and "0 bytes" then
+ * gets misread as "the board is dead". Holding turns the boot into a continuous
+ * stream -- UUUU1111222233334444... -- so the capture can start anywhere and the
+ * LAST character received names the last step that completed. No gap can hide
+ * it and no reset-button behaviour is assumed. */
+/* One character per marker.  This used to hold each marker for 20 x HAL_Delay(100)
+ * = 2 s so that a one-shot boot marker could not be lost in the ~8 s usbipd
+ * re-attach gap.  That job is now done once, by the HAL_Delay(12000) after
+ * UART_Config below, and the holds were costing ~32 s of wall clock per run --
+ * which is what made round 13 misread a fast graph as a slow one. */
+#define BEACON(c) beacon(c)
+
+/* ---- per-epoch trace ------------------------------------------------------
+ * Round 8 put the hang inside __ll_aton_stai_run_synchonously: no interrupt is
+ * trapped and no fault is raised, so the M55 is going round
+ *
+ *   do { r = LL_ATON_RT_RunEpochBlock(inst);
+ *        if (r == LL_ATON_RT_WFE) LL_ATON_OSAL_WFE(); } while (r != DONE);
+ *
+ * while an epoch it started never reports completion. This names that epoch.
+ *
+ * The runtime calls this once per epoch block with the block item, and the
+ * build already defines LL_ATON_EB_DBG_INFO, so `epoch_num` and the streaming
+ * engine masks are populated. Format is `<NNN` on start and `>` on end, so the
+ * last number printed WITHOUT a following `>` is the epoch that hung, and the
+ * masks printed with it say which engines it was waiting on.
+ *
+ * Raw USART1 writes only -- no printf, because this may run in ISR context. */
+#ifdef GATE4_EPOCH_TRACE
+static void g4_num(uint32_t v, int digits)
+{
+  uint32_t div = 1;
+  for (int i = 1; i < digits; i++) div *= 10u;
+  for (; div > 0u; div /= 10u) beacon((char)('0' + ((v / div) % 10u)));
+}
+
+/* The stai layer OVERWRITES any callback set with LL_ATON_RT_SetNetworkCallback()
+ * on every single run (ll_aton_stai_internal.c:417-425):
+ *
+ *   if (nn_context->callback != NULL)
+ *     LL_ATON_RT_SetNetworkCallback(inst, _stai_aton_internal_epoch_block_callback);
+ *   else
+ *     LL_ATON_RT_SetNetworkCallback(inst, NULL);
+ *
+ * and `_stai_aton_context.callback` is never assigned anywhere in the middleware
+ * -- there is no public per-network setter, only the runtime-wide
+ * stai_runtime_set_callback(), which feeds a different hook. So the documented
+ * epoch-callback path is dead unless the context field is set directly. That is
+ * what this does; stai then installs its own forwarder, which calls us. */
+static uint32_t g4_ep_t0;
+static uint64_t g4_ep_tot;
+static uint32_t g4_ep_n;
+
+/* Trace every epoch from GATE4_EPOCH_FROM onward, and only a cumulative total
+ * before that.  Printing costs ~14 ms per epoch at 14400 baud, so tracing all 628
+ * both distorts the timing and takes long enough that the capture window closes
+ * before the interesting region.  Rounds 9-10 named the first blocker this way;
+ * this is the same method aimed further in. */
+#ifndef GATE4_EPOCH_FROM
+#define GATE4_EPOCH_FROM 280u
+#endif
+
+static void g4_epoch_cb(void *cookie, const stai_event_type type, const void *payload)
+{
+  (void)cookie;
+  const LL_ATON_RT_EpochBlockItem_t *eb = (const LL_ATON_RT_EpochBlockItem_t *)payload;
+  if (type == (stai_event_type)LL_ATON_RT_Callbacktype_PRE_START)
+  {
+    /* Print BEFORE taking the timestamp.  Getting this backwards put an
+     * 18-character UART write inside the measured window -- 18 x 694 us at 14400
+     * baud with a TC wait each = 12.5 ms -- and produced the bogus "uniform
+     * 12.6 ms per-epoch penalty" of round 15. */
+    if (g4_ep_n >= GATE4_EPOCH_FROM)
+    {
+      beacon('\r'); beacon('\n'); beacon('<');
+      g4_num(g4_ep_n, 3);
+      if (eb != NULL)
+      {
+        beacon('f'); g4_num((uint32_t)eb->flags, 3);
+        beacon('i'); g4_num(eb->in_streng_mask, 3);
+        beacon('o'); g4_num(eb->out_streng_mask, 3);
+      }
+    }
+    g4_ep_t0 = (uint32_t)port_dwt_get_cycles();
+  }
+  else if (type == (stai_event_type)LL_ATON_RT_Callbacktype_POST_END)
+  {
+    uint32_t dt = (uint32_t)port_dwt_get_cycles() - g4_ep_t0;
+    g4_ep_tot += (uint64_t)dt;
+    if (g4_ep_n >= GATE4_EPOCH_FROM)
+    {
+      beacon('>'); g4_num(dt, 8);
+    }
+    else if ((g4_ep_n % 64u) == 0u)
+    {
+      beacon('\r'); beacon('\n'); beacon('E');
+      g4_num(g4_ep_n, 3); beacon('t'); g4_num((uint32_t)(g4_ep_tot / 600000u), 6);
+    }
+    g4_ep_n++;
+  }
