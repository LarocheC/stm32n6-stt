+   * cycle detaches the USB device and usbipd takes ~8 s to re-attach, by which
+   * time the board has long since printed.  Looping also turns a single latency
+   * reading into a distribution, which is the number Gate 4 actually owes. */
+  for (uint32_t run = 0; ; run++)
+  {
+  my_printf("\r\n# ---- run %lu ----\r\n", (unsigned long)run);
+
+  int8_t *in  = (int8_t *) g4_aictx.p_stai_inputs[0];
+  int8_t *out = (int8_t *) g4_aictx.p_stai_outputs[0];
+  my_printf("# in=%p out=%p scale=%f off=%d\r\n", in, out,
+            (double)g4_aictx.input_Q_inv_scale,
+            (int)g4_aictx.input_Q_offset);
+
+  /* Clamp to the installed model's real input size so this harness can also be
+   * pointed at ST's own AED model as a control. The bytes are meaningless for a
+   * model that is not Citrinet; the only question asked in that case is whether
+   * AiDPUProcess() returns at all. */
+  uint32_t in_bytes = (uint32_t)STAI_NETWORK_IN_1_SIZE_BYTES;
+  if (in_bytes > (uint32_t)sizeof(kCannedFeatures)) in_bytes = (uint32_t)sizeof(kCannedFeatures);
+  memcpy(in, kCannedFeatures, in_bytes);
+  mcu_cache_clean_invalidate_range((uint32_t)in, (uint32_t)in + in_bytes);
+  my_printf("# fed %lu B of %d B input\r\n", (unsigned long)in_bytes,
+            (int)STAI_NETWORK_IN_1_SIZE_BYTES);
+
+  /* Cycle counter for the invoke.
+   *
+   * NOT DWT.  ai_device_adaptor.h:245 sets HAS_DWT_CTRL 0 for this part and maps
+   * port_dwt_get_cycles() to ARM_PMU_Get_CCNTR(): the Cortex-M55 counts cycles in
