+#ifdef GATE4_CANNED
+/**
+ * Gate 4: prove the Citrinet graph on silicon with the microphone, the MDF
+ * decimator, the log-mel front end and the gain stage all removed from the
+ * comparison. Feeds one host-computed int8 tensor and prints the per-frame
+ * argmax, so any divergence from host ONNX Runtime is the model, the runtime,
+ * or cache coherency -- nothing else is in the path.
+ */
+static void gate4_canned(void)
+{
+  BEACON('E');
+  my_printf("\r\n# gate4: canned features, mic bypassed\r\n");
+  BEACON('L');
+
+
+  if (AiDPULoadModel(&g4_aictx) != DPU_OK)
+  {
+    BEACON('!');
+    my_printf("# gate4: AiDPULoadModel FAILED\r\n");
+    return;
+  }
+  BEACON('M');
+
+#ifdef GATE4_EPOCH_TRACE
+  /* stai_network * IS the _stai_aton_context (network_instance is its first
+   * member).  Setting .callback makes stai install its internal epoch forwarder
+   * on every run, which then calls g4_epoch_cb.
+   *
+   * Off by default: the trace emits ~20 characters per epoch and beacon() waits
+   * for USART_ISR_TC on each one, so at 14400 baud with the FIFO disabled it adds
+   * ~14 ms per epoch -- roughly 9 s across a 628-epoch graph.  Useful for finding
+   * a stalled epoch, useless while measuring one. */
+  {
+    _stai_aton_context *g4_ctx = (_stai_aton_context *)g4_aictx.p_network;
+    g4_ctx->callback = g4_epoch_cb;
+    g4_ctx->callback_cookie = NULL;
+    beacon(g4_ctx->callback != NULL ? 'K' : 'k');
+  }
+#endif
+
