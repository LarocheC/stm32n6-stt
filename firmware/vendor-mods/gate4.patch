+/* ---- Gate 4 trap reporter -------------------------------------------------
+ * Almost every handler in this file is `g4_trap();` -- a deliberate trap for
+ * an interrupt ST does not expect. That means ANY unexpected interrupt hangs the
+ * CPU forever inside its ISR, with no fault and no output, which is exactly the
+ * signature of the Citrinet invoke that never returns.
+ *
+ * Rather than instrument 190 handlers, this reads IPSR -- which holds the active
+ * exception number -- and streams it out of USART1 forever, raw, with no printf
+ * and no buffering. Whatever number arrives names the interrupt that fired.
+ * Exception number = IRQn + 16 (so NPU0..NPU3 = 16+IRQn, HardFault = 3). */
+#ifdef GATE4_BEACON
+static void g4_putc(char c)
+{
+  while ((USART1->ISR & USART_ISR_TXE_TXFNF) == 0U) { }
+  USART1->TDR = (uint32_t)(uint8_t)c;
+  while ((USART1->ISR & USART_ISR_TC) == 0U) { }
+}
+static void g4_hex(uint32_t v)
+{
+  for (int i = 28; i >= 0; i -= 4)
+    g4_putc("0123456789abcdef"[(v >> i) & 0xFU]);
+}
+void g4_trap(void)
+{
+  uint32_t xn = __get_IPSR() & 0x1FFU;
+  /* Fault status, so a HardFault names itself instead of just its number.
+   * CFSR splits into MMFSR/BFSR/UFSR; HFSR bit30 = FORCED (escalated from a
+   * configurable fault); MMFAR/BFAR hold the offending address when the
+   * matching VALID bit is set. */
+  uint32_t cfsr  = *(volatile uint32_t *)0xE000ED28U;
+  uint32_t hfsr  = *(volatile uint32_t *)0xE000ED2CU;
+  uint32_t mmfar = *(volatile uint32_t *)0xE000ED34U;
+  uint32_t bfar  = *(volatile uint32_t *)0xE000ED38U;
+  uint32_t sp    = __get_MSP();
+  for (;;)
+  {
+    g4_putc('\r'); g4_putc('\n'); g4_putc('!');
+    g4_putc((char)('0' + ((xn / 100U) % 10U)));
+    g4_putc((char)('0' + ((xn / 10U) % 10U)));
+    g4_putc((char)('0' + (xn % 10U)));
+    g4_putc(' '); g4_putc('C'); g4_hex(cfsr);
+    g4_putc(' '); g4_putc('H'); g4_hex(hfsr);
+    g4_putc(' '); g4_putc('M'); g4_hex(mmfar);
+    g4_putc(' '); g4_putc('B'); g4_hex(bfar);
+    /* a window of the stack: the exception frame (r0-r3,r12,lr,pc,xpsr) is in
+     * here, so the stacked PC identifies the faulting instruction */
+    g4_putc(' '); g4_putc('S'); g4_hex(sp);
+    for (int i = 0; i < 16; i++)
+    {
+      g4_putc(' '); g4_hex(*(volatile uint32_t *)(sp + (uint32_t)(i * 4)));
+    }
+    for (volatile uint32_t d = 0; d < 8000000U; d++) { }
+  }
+}
+#else
+void g4_trap(void) { while (1) {} }
+#endif
