+  my_printf("# invoke returned\r\n");
+
+  /* the stock app never invalidates the output; the NPU writes it by another
+   * path and the M55 D-cache may hold stale lines. */
+  mcu_cache_invalidate_range((uint32_t)out,
+                             (uint32_t)out + (uint32_t)CANNED_N_FRAMES * CANNED_NVOCAB);
+
+  my_printf("# invoke %lu cycles = %d.%03d ms at %lu Hz\r\n",
+            (unsigned long)cycles,
+            (int)((uint64_t)cycles * 1000u / port_hal_get_cpu_freq()),
+            (int)(((uint64_t)cycles * 1000000u / port_hal_get_cpu_freq()) % 1000u),
+            (unsigned long)port_hal_get_cpu_freq());
+
+  uint32_t mismatches = 0;
+  const uint32_t out_bytes = (uint32_t)STAI_NETWORK_OUT_1_SIZE_BYTES;
+  const uint32_t n_frames  = (out_bytes >= (uint32_t)CANNED_N_FRAMES * CANNED_NVOCAB)
+                             ? (uint32_t)CANNED_N_FRAMES : 0u;
+  if (n_frames == 0u) { my_printf("# output too small for CTC argmax (control run)\r\n"); HAL_Delay(3000); continue; }
+  my_printf("# ids:");
+  for (uint32_t f = 0; f < n_frames; f++)
+  {
+    const int8_t *row = out + (uint32_t)f * CANNED_NVOCAB;
+    int8_t  best_v = row[0];
+    uint32_t best_i = 0;
+    for (uint32_t v = 1; v < CANNED_NVOCAB; v++)
+    {
+      if (row[v] > best_v) { best_v = row[v]; best_i = v; }
+    }
+    my_printf(" %lu", (unsigned long)best_i);
+    if (best_i != kExpectedTokens[f]) mismatches++;
+  }
+  my_printf("\r\n# mismatches %lu / %u\r\n",
+            (unsigned long)mismatches, (unsigned)CANNED_N_FRAMES);
+  my_printf(mismatches ? "# GATE4 FAIL\r\n" : "# GATE4 PASS\r\n");
+  HAL_Delay(3000);
+  }
+}
+#endif /* GATE4_CANNED */
+
+#ifdef GATE4_CORPUS
+/* stm32n6-stt: multi-utterance device-vs-host comparison.
+ *
+ * Gate 4's execution question is closed (board/GATE4.md Round 19: 448 epochs,
+ * 124.0 ms, deterministic across two schedules). What is open is whether the
+ * device's int8 arithmetic is close enough to the host's, and one canned
+ * utterance cannot answer that -- 4 word errors in 17 words is a Wilson
+ * interval of [9.6 %, 47.3 %].
+ *
+ * So: a corpus of N feature tensors is flashed to external flash, and this loops
+ * over them printing the argmax ids for each. Scoring is host-side
+ * (firmware/test/score_corpus.py) -- the board's job is to report what it
+ * computed, not to judge it.
+ *
+ * The blob is NOT compiled in. 64 utterances is 4 MB of .rodata against a 1 MB
+ * RAM region that is already at 77 % with a single tensor, and this application
+ * is copied to RAM to run. It lives in external flash instead, memory-mapped by
+ * Ext_Mem_Config() exactly as the weight blob at 0x70400000 is, and is read from
+ * there directly. The weights end around 0x70D9C000, so 0x71000000 is clear.
+ *
+ * Layout, matching firmware/tools/gen_corpus.py:
+ *   0x00  "STTC"   0x04  uint32 N   0x08  uint32 T   0x0C  uint32 NMEL
+ *   0x40  N tensors of T*NMEL int8, mel-major, back to back
+ */
+#define GATE4_CORPUS_BASE 0x71000000u
+
+static void gate4_corpus(void)
+{
+  const volatile uint32_t *hdr = (const volatile uint32_t *)GATE4_CORPUS_BASE;
+  const uint32_t magic = hdr[0];
+  const uint32_t n_utt = hdr[1];
+  const uint32_t t_len = hdr[2];
+  const uint32_t n_mel = hdr[3];
+
+  my_printf("\r\n# gate4 corpus @ %p magic=%08lx N=%lu T=%lu NMEL=%lu\r\n",
+            (void *)GATE4_CORPUS_BASE, (unsigned long)magic,
+            (unsigned long)n_utt, (unsigned long)t_len, (unsigned long)n_mel);
+
+  /* "STTC" little-endian. A blank or mis-flashed slot reads 0xFFFFFFFF or 0, and
+   * silently scoring garbage would be worse than not running. */
+  if (magic != 0x43545453u)
+  {
+    my_printf("# corpus magic bad -- expected 43545453, flash the blob to %p\r\n",
+              (void *)GATE4_CORPUS_BASE);
+    return;
+  }
+
+  const uint32_t utt_bytes = t_len * n_mel;
+  if (utt_bytes != (uint32_t)STAI_NETWORK_IN_1_SIZE_BYTES)
+  {
+    my_printf("# corpus geometry %lu B != model input %d B -- refusing\r\n",
+              (unsigned long)utt_bytes, (int)STAI_NETWORK_IN_1_SIZE_BYTES);
+    return;
+  }
+
+  if (AiDPULoadModel(&g4_aictx) != DPU_OK)
+  {
+    my_printf("# gate4 corpus: AiDPULoadModel FAILED\r\n");
+    return;
+  }
+
+  int8_t *in  = (int8_t *) g4_aictx.p_stai_inputs[0];
+  int8_t *out = (int8_t *) g4_aictx.p_stai_outputs[0];
+  const uint32_t out_bytes = (uint32_t)STAI_NETWORK_OUT_1_SIZE_BYTES;
+  const uint32_t n_frames  = out_bytes / (uint32_t)CANNED_NVOCAB;
+
+  for (uint32_t pass = 0; ; pass++)
+  {
+    my_printf("\r\n# ---- corpus pass %lu ----\r\n", (unsigned long)pass);
+
+    for (uint32_t i = 0; i < n_utt; i++)
+    {
+      const int8_t *src = (const int8_t *)(GATE4_CORPUS_BASE + 0x40u + i * utt_bytes);
+      memcpy(in, src, utt_bytes);
+      mcu_cache_clean_invalidate_range((uint32_t)in, (uint32_t)in + utt_bytes);
+
+      port_dwt_reset();
+      uint32_t t0 = (uint32_t)port_dwt_get_cycles();
+      AiDPUProcess(&g4_aictx);
+      uint32_t cycles = (uint32_t)port_dwt_get_cycles() - t0;
+
+      /* the stock app never invalidates the output; the NPU writes it by another
+       * path and the M55 D-cache may hold stale lines. */
+      mcu_cache_invalidate_range((uint32_t)out, (uint32_t)out + out_bytes);
+
+      my_printf("# u %lu cyc %lu ids:", (unsigned long)i, (unsigned long)cycles);
+      for (uint32_t f = 0; f < n_frames; f++)
+      {
+        const int8_t *row = out + f * (uint32_t)CANNED_NVOCAB;
+        int8_t   best_v = row[0];
+        uint32_t best_i = 0;
+        for (uint32_t v = 1; v < (uint32_t)CANNED_NVOCAB; v++)
+        {
+          if (row[v] > best_v) { best_v = row[v]; best_i = v; }
+        }
+        my_printf(" %lu", (unsigned long)best_i);
+      }
+      my_printf("\r\n");
+    }
+
+    my_printf("# corpus done %lu utterances\r\n", (unsigned long)n_utt);
+    HAL_Delay(5000);
+  }
+}
+#endif /* GATE4_CORPUS */
+
+#if defined(GATE5_WAV) || defined(GATE5_MIC)
+/* stm32n6-stt: Gate 5 bring-up -- replay canned WAVEFORMS through the real
+ * front end on the M55, then the NPU, in one image.
+ *
+ * Gate 4 proved the NPU (board/GATE4.md Round 19: 448 epochs, 124.0 ms) using
+ * HOST-computed features. firmware/src/citrinet_fe.c reproduces model/fe.py
+ * exactly on a workstation -- 0 of 768,000 int8 values differ -- but has never
+ * run on this silicon, and its cost here is the largest unmeasured number in the
+ * project (firmware/FRONTEND.md section 7). This path measures it and proves
+ * waveform -> features -> NPU end to end, without touching the microphone or the
+ * gain stage.
+ *
+ * MEMORY. The front end needs 256,000 B of pass-1 scratch in the SHIPPING
+ * float32 configuration; the fp16 variant halves it but costs 3,982 of 768,000
+ * int8 values (FRONTEND.md section 5), which would confound the very comparison
+ * this run exists to make. Together with a 256,000 B PCM buffer that does not fit
+ * beside the model in the 1023 K RAM region.
+ *
+ * It does not have to. docs/MEMORY-MAP.md records AXISRAM3/4/5 (448 K each at
+ * 0x34200000/0x34270000/0x342E0000) as holding NOTHING: the linker script
+ * declares only AXISRAM1, and ST's mpool gives the model only cpuRAM2 and
+ * npuRAM6. Int_Mem_Config() already clocks them out of shutdown
+ * (RCC_MEMENR_AXISRAM3EN|4EN|5EN). So the two big buffers go there, and the
+ * application's own region is untouched.
+ *
+ * The three banks are CONTIGUOUS -- 0x34200000 + 3 x 0x70000 = 0x34350000,
+ * where npuRAM6 begins -- so they are one 1,376,256 B block, which is what lets
+ * Gate 7 put a full 800x480x2 = 768,000 B framebuffer below the two audio
+ * buffers without a PSRAM region, a linker script change, -DUSE_EXT_SRAM, or the
+ * RISAF question that firmware/WORKLIST.md section 7.4 raises:
+ *
+ *   0x34200000  LCD framebuffer   768,000 B
+ *   0x342BC000  PCM               256,000 B
+ *   0x342FB000  front-end scratch 256,000 B
+ *   0x34339800  free               92,160 B  up to npuRAM6 at 0x34350000
+ *
+ * Both banks are probed before use rather than assumed -- a bank that is not
+ * clocked reads back garbage, and silently scoring garbage would be worse than
+ * not running.
+ */
+#define GATE5_WAV_BASE     0x72000000u   /* waveform blob in external flash     */
+#define GATE5_PCM_RAM      0x342BC000u   /* AXISRAM3/4, above the framebuffer   */
+#define GATE5_SCRATCH_RAM  0x342FB000u   /* AXISRAM4/5                          */
+
+static citrinet_fe_t g5_fe;
+
+/* FNV-1a 32, over the feature tensor. The host computes the same hash, so one
+ * 8-hex-digit field per utterance answers "did the M55 compute the same
+ * features" without sending 64,000 bytes up a 14400-baud line. */
+static uint32_t g5_fnv1a(const uint8_t *p, uint32_t n)
+{
+  uint32_t h = 2166136261u;
+  for (uint32_t i = 0; i < n; i++) { h ^= p[i]; h *= 16777619u; }
+  return h;
+}
+
+static void g5_hex8(uint32_t v)
+{
+  static const char d[] = "0123456789abcdef";
+  for (int i = 28; i >= 0; i -= 4) my_printf("%c", d[(v >> i) & 0xFu]);
+}
+
+/* Write, read back, restore. Returns 1 if the bank holds what it is given. */
+static int g5_probe_ram(uint32_t base)
+{
+  volatile uint32_t *p = (volatile uint32_t *)base;
+  const uint32_t save0 = p[0], save1 = p[1];
+  p[0] = 0xA5A5F00Du; p[1] = 0x5A5A0FF0u;
+  __DSB();
+  const int ok = (p[0] == 0xA5A5F00Du) && (p[1] == 0x5A5A0FF0u);
+  p[0] = save0; p[1] = save1;
+  return ok;
+}
+
+/* Probe the two scratch banks, bring up the front end and load the network.
+ * Hoisted out of gate5_wav() so gate5_mic() can share it, and idempotent so an
+ * image that runs the replay first and the microphone afterwards loads the
+ * network once. */
+static int g5_ready;
+
+static int g5_init_common(const char *who)
+{
+  if (g5_ready) return 1;
+
+  if (!g5_probe_ram(GATE5_PCM_RAM) || !g5_probe_ram(GATE5_SCRATCH_RAM))
+  {
+    my_printf("# %s: AXISRAM3/4 did not hold a written pattern -- refusing\r\n", who);
+    return 0;
+  }
+  if (citrinet_fe_init(&g5_fe, (void *)GATE5_SCRATCH_RAM,
+                       CITRINET_FE_SCRATCH_BYTES) != CITRINET_FE_OK)
+  {
+    my_printf("# %s: citrinet_fe_init failed\r\n", who);
+    return 0;
+  }
+  if (AiDPULoadModel(&g4_aictx) != DPU_OK)
+  {
+    my_printf("# %s: AiDPULoadModel FAILED\r\n", who);
+    return 0;
+  }
+  g5_ready = 1;
+  return 1;
+}
+
+/* The 80 mel rows of the feature tensor, hashed one at a time.
+ * firmware/test/score_wav.py computes the same 80 hashes on the host
+ * (row b is bytes [b*800, (b+1)*800) -- citrinet_fe.h: out[b*800 + t]), so a
+ * whole-tensor hash that disagrees turns into "these mel bins" for free.
+ * Cheap enough to leave on: 80 * 800 bytes of FNV-1a per utterance. */
+static void g5_print_row_hashes(const int8_t *in, uint32_t utt, const char *tag)
+{
+  my_printf("# R %lu %s", (unsigned long)utt, tag);
+  for (uint32_t b = 0; b < (uint32_t)CITRINET_FE_NMEL; b++)
+  {
+    my_printf(" ");
+    g5_hex8(g5_fnv1a((const uint8_t *)in + b * (uint32_t)CITRINET_FE_T,
+                     (uint32_t)CITRINET_FE_T));
+  }
+  my_printf("\r\n");
+}
+
+/* The same 80 rows, as sums.  A hash says "this row differs" and stops there;
+ * the sums say BY HOW MUCH.  Round 21 left four utterances disagreeing with the
+ * host, and the row hashes localised each to one or two isolated, non-adjacent
+ * mel bins -- which rules out the FFT, the pre-emphasis and the input samples,
+ * since any of those would move all 80 rows, and rules out the mel table, which
+ * would move a contiguous run.  What is left is a single int8 value crossing a
+ * rounding boundary, and that is a claim about magnitude: sum differs by +-1 and
+ * sumabs by +-1 means exactly one value moved by one LSB.  Signed sum alone is
+ * not enough -- two values moving +1 and -1 leave it unchanged. */
+static void g5_print_row_sums(const int8_t *in, uint32_t utt, const char *tag)
+{
+  my_printf("# S %lu %s", (unsigned long)utt, tag);
+  for (uint32_t b = 0; b < (uint32_t)CITRINET_FE_NMEL; b++)
+  {
+    const int8_t *row = in + b * (uint32_t)CITRINET_FE_T;
+    int32_t sum = 0, sumabs = 0;
+    for (uint32_t t = 0; t < (uint32_t)CITRINET_FE_T; t++)
+    {
+      const int32_t v = (int32_t)row[t];
+      sum += v;
+      sumabs += (v < 0 ? -v : v);
+    }
+    my_printf(" %ld,%ld", (long)sum, (long)sumabs);
+  }
+  my_printf("\r\n");
+}
+#endif /* GATE5_WAV || GATE5_MIC */
+
+#ifdef GATE5_WAV
+static void gate5_wav(uint32_t passes, int rowhash)
+{
+  const volatile uint32_t *hdr = (const volatile uint32_t *)GATE5_WAV_BASE;
+  const uint32_t magic = hdr[0], n_utt = hdr[1], n_samp = hdr[2];
+
+  my_printf("\r\n# gate5 wav @ %p magic=%08lx N=%lu NSAMPLES=%lu\r\n",
+            (void *)GATE5_WAV_BASE, (unsigned long)magic,
+            (unsigned long)n_utt, (unsigned long)n_samp);
+  my_printf("# fe backend=%d tables_fnv1a=%08lx scratch=%lu B\r\n",
+            citrinet_fe_backend(), (unsigned long)citrinet_fe_tables_fnv1a(),
+            (unsigned long)CITRINET_FE_SCRATCH_BYTES);
+
+  if (magic != 0x57545453u)   /* "STTW" little-endian */
+  {
+    my_printf("# wav magic bad -- expected 57545453, flash the blob to %p\r\n",
+              (void *)GATE5_WAV_BASE);
+    return;
+  }
+  if (n_samp != (uint32_t)CITRINET_FE_NSAMPLES)
+  {
+    my_printf("# wav NSAMPLES %lu != %d -- refusing\r\n",
+              (unsigned long)n_samp, (int)CITRINET_FE_NSAMPLES);
+    return;
+  }
+  if (!g5_init_common("gate5 wav")) return;
+
+  int16_t *pcm = (int16_t *)GATE5_PCM_RAM;
+
+  int8_t *in  = (int8_t *) g4_aictx.p_stai_inputs[0];
+  int8_t *out = (int8_t *) g4_aictx.p_stai_outputs[0];
+  const uint32_t in_bytes  = (uint32_t)STAI_NETWORK_IN_1_SIZE_BYTES;
+  const uint32_t out_bytes = (uint32_t)STAI_NETWORK_OUT_1_SIZE_BYTES;
+  const uint32_t n_frames  = out_bytes / (uint32_t)CANNED_NVOCAB;
+  /* the DPU carries 1/scale; citrinet_fe_finish() divides by the scale itself */
+  const float q_scale = 1.0f / g4_aictx.input_Q_inv_scale;
+  const uint32_t pcm_bytes = n_samp * (uint32_t)sizeof(int16_t);
+
+  for (uint32_t pass = 0; passes == 0u || pass < passes; pass++)
+  {
+    my_printf("\r\n# ---- wav pass %lu ----\r\n", (unsigned long)pass);
+
+    for (uint32_t i = 0; i < n_utt; i++)
+    {
+      /* Copy the waveform to on-chip RAM FIRST. Pointing the front end straight
+       * at memory-mapped flash would make citrinet_fe_build_frame()'s ~640,000
+       * int16 loads XSPI reads with prefetch disabled ("Hotfix for xspi: no
+       * prefetch", Ext_Mem_Config), and the measurement would be of the flash,
+       * not of the front end. Round 20 saw exactly that cost 13 % on the NPU. */
+      memcpy(pcm, (const void *)(GATE5_WAV_BASE + 0x40u + i * pcm_bytes), pcm_bytes);
+
+      port_dwt_reset();
+      uint32_t t0 = (uint32_t)port_dwt_get_cycles();
+      int rc = citrinet_fe_run(&g5_fe, pcm, n_samp, q_scale, 0, in);
+      uint32_t t1 = (uint32_t)port_dwt_get_cycles();
+      uint32_t fe_cycles = t1 - t0;
+
+      /* Hash BEFORE the invoke: the allocator legitimately aliases the input and
+       * output buffers once the input is dead (board/GATE4.md Round 1), so after
+       * AiDPUProcess() this buffer may hold logits. */
+      uint32_t fhash = g5_fnv1a((const uint8_t *)in, in_bytes);
+      /* also BEFORE the invoke, for the same aliasing reason */
+      if (rowhash) { g5_print_row_hashes(in, i, "wav");
+                     g5_print_row_sums(in, i, "wav"); }
+
+      mcu_cache_clean_invalidate_range((uint32_t)in, (uint32_t)in + in_bytes);
+
+      /* Reset again. The first waveform run measured fe+npu summing to a
+       * CONSTANT 83.45 M cycles while the split tracked `guard`, which two
+       * fixed-cost stages cannot do -- so one read was not what it looked like.
+       * Reset before each stage and print the raw reads alongside the deltas
+       * rather than infer. */
+      port_dwt_reset();
+      uint32_t n0 = (uint32_t)port_dwt_get_cycles();
+      AiDPUProcess(&g4_aictx);
+      uint32_t n1 = (uint32_t)port_dwt_get_cycles();
+      uint32_t npu_cycles = n1 - n0;
+
+      mcu_cache_invalidate_range((uint32_t)out, (uint32_t)out + out_bytes);
+
+      my_printf("# w %lu fe %lu npu %lu raw %lu,%lu,%lu,%lu rc %d guard %lu hash ",
+                (unsigned long)i, (unsigned long)fe_cycles,
+                (unsigned long)npu_cycles,
+                (unsigned long)t0, (unsigned long)t1,
+                (unsigned long)n0, (unsigned long)n1, rc,
+                (unsigned long)g5_fe.guard_below);
+      g5_hex8(fhash);
+      my_printf(" ids:");
+      for (uint32_t f = 0; f < n_frames; f++)
+      {
+        const int8_t *row = out + f * (uint32_t)CANNED_NVOCAB;
+        int8_t   best_v = row[0];
+        uint32_t best_i = 0;
+        for (uint32_t v = 1; v < (uint32_t)CANNED_NVOCAB; v++)
+          if (row[v] > best_v) { best_v = row[v]; best_i = v; }
+        my_printf(" %lu", (unsigned long)best_i);
+      }
+      my_printf("\r\n");
+    }
+
+    my_printf("# wav done %lu utterances\r\n", (unsigned long)n_utt);
+    if (passes == 0u) HAL_Delay(5000);
+  }
+}
+#endif /* GATE5_WAV */
+
+#ifdef GATE7_LCD
+/* stm32n6-stt: Gate 7 -- the transcript on the 800x480 panel.
+ *
+ * The audio package is strictly headless: no stm32n6570_discovery_lcd.c in its
+ * BSP, no Utilities/, no fonts. Everything here is grafted from
+ * STM32N6-GettingStarted-ObjectDetection and lives in firmware/lcd/, mirroring
+ * that package's directory layout so every relative #include -- and
+ * stm32_lcd.c's habit of textually #including all five font .c files -- resolves
+ * unmodified.
+ *
+ * NO PSRAM. firmware/WORKLIST.md section 7.4 budgets a linker PSRAM region,
+ * -DUSE_EXT_SRAM and an unresolved RISAF question for the 768,000 B framebuffer.
+ * None of that is needed: AXISRAM3/4/5 are CONTIGUOUS (0x34200000 + 3 x 0x70000
+ * = 0x34350000, where npuRAM6 starts), the mpool claims none of them, and
+ * Int_Mem_Config() already clocks them. The framebuffer takes the bottom
+ * 768,000 B and the two audio buffers move above it -- see the map at
+ * GATE5_PCM_RAM. That the LTDC master can reach AXISRAM at all is not an
+ * assumption: ST's own ObjectDetection app puts its layer 0 at 0x34200000.
+ *
+ * One layer, RGB565, full screen. The OD app needs two (camera background plus
+ * an ARGB4444 overlay); a captioner redraws one surface per utterance.
+ */
+#define G7_FB_ADDR    ((uint32_t)LCD_LAYER_0_ADDRESS)
+#define G7_W          800u
+#define G7_H          480u
+#define G7_FB_BYTES   (G7_W * G7_H * 2u)
+#define G7_COLS       57u     /* Font20 is 14 px wide: 800/14 */
+#define G7_LH         20u     /* Font20 height                */
+#define G7_MAXLINES   4u
+#define G7_SPEC_Y     176u    /* spectrogram band, 80 bins x 3 px */
+#define G7_SPEC_PX    3u
+#define G7_SPEC_H     (CITRINET_FE_NMEL * G7_SPEC_PX)
+#define G7_STATS_Y    452u
+
+static int  g7_up;
+static char g7_line[G7_COLS + 1u];
+
+/* RIF, copied from the ObjectDetection app's Security_Config(). The audio app's
+ * NPU_Config() opens the NPU master and nothing else, so without this the LTDC
+ * and DMA2D masters are not authorised and the panel stays dark. */
+static void g7_rif(void)
+{
+  __HAL_RCC_RIFSC_CLK_ENABLE();
+  RIMC_MasterConfig_t m = {0};
+  m.MasterCID = RIF_CID_1;
+  m.SecPriv   = RIF_ATTRIBUTE_SEC | RIF_ATTRIBUTE_PRIV;
+  HAL_RIF_RIMC_ConfigMasterAttributes(RIF_MASTER_INDEX_DMA2D, &m);
+  HAL_RIF_RIMC_ConfigMasterAttributes(RIF_MASTER_INDEX_LTDC1, &m);
+  HAL_RIF_RIMC_ConfigMasterAttributes(RIF_MASTER_INDEX_LTDC2, &m);
+  HAL_RIF_RISC_SetSlaveSecureAttributes(RIF_RISC_PERIPH_INDEX_DMA2D,
+                                        RIF_ATTRIBUTE_SEC | RIF_ATTRIBUTE_PRIV);
+  HAL_RIF_RISC_SetSlaveSecureAttributes(RIF_RISC_PERIPH_INDEX_LTDC,
+                                        RIF_ATTRIBUTE_SEC | RIF_ATTRIBUTE_PRIV);
+  HAL_RIF_RISC_SetSlaveSecureAttributes(RIF_RISC_PERIPH_INDEX_LTDCL1,
+                                        RIF_ATTRIBUTE_SEC | RIF_ATTRIBUTE_PRIV);
+  HAL_RIF_RISC_SetSlaveSecureAttributes(RIF_RISC_PERIPH_INDEX_LTDCL2,
+                                        RIF_ATTRIBUTE_SEC | RIF_ATTRIBUTE_PRIV);
+}
+
+/* The M55 draws through its D-cache; the LTDC reads the framebuffer by another
+ * path. Without this the panel shows whatever was in AXISRAM3 at reset. */
+static void g7_flush(void)
+{
+  mcu_cache_clean_range(G7_FB_ADDR, G7_FB_ADDR + G7_FB_BYTES);
+}
+
+/* Direct framebuffer writes for the meter and the spectrogram. UTIL_LCD's
+ * per-pixel entry points are function calls; the spectrogram is 192,000 pixels
+ * and the meter redraws ten times a second, so both write RGB565 straight into
+ * the layer and flush only the rows they touched. */
+static inline uint16_t g7_rgb(uint32_t r, uint32_t g, uint32_t b)
+{
+  return (uint16_t)(((r & 0xF8u) << 8) | ((g & 0xFCu) << 3) | (b >> 3));
+}
+
+static void g7_fill(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t c)
+{
+  uint16_t *fb = (uint16_t *)G7_FB_ADDR;
+  for (uint32_t j = 0; j < h; j++)
+  {
+    uint16_t *row = fb + (uint32_t)(y + j) * G7_W + x;
+    for (uint32_t i = 0; i < w; i++) row[i] = c;
+  }
+}
+
+static void g7_flush_rows(uint32_t y, uint32_t h)
+{
+  const uint32_t a = G7_FB_ADDR + (uint32_t)y * G7_W * 2u;
+  mcu_cache_clean_range(a, a + (uint32_t)h * G7_W * 2u);
+}
+
+static void g7_at(uint32_t x, uint32_t y, const char *t, Text_AlignModeTypdef m)
+{
+  UTIL_LCD_DisplayStringAt(x, y, (uint8_t *)t, m);
+}
+
+/* Word wrap. Breaks at the last space that fits; falls back to a hard cut for a
+ * word longer than the line, which a CTC decoder can certainly produce. */
+static uint32_t g7_wrap(const char *s, uint32_t x, uint32_t y0, uint32_t maxlines)
+{
+  uint32_t li = 0;
+  while (*s && li < maxlines)
+  {
+    uint32_t k = 0;
+    while (s[k] && k < G7_COLS) k++;
+    uint32_t cut = k;
+    if (s[k])
+    {
+      uint32_t b = k;
+      while (b > 0u && s[b] != ' ') b--;
+      if (b > 0u) cut = b;
+    }
+    memcpy(g7_line, s, cut);
+    g7_line[cut] = '\0';
+    g7_at(x, y0 + li * G7_LH, g7_line, LEFT_MODE);
+    li++;
+    s += cut;
+    while (*s == ' ') s++;
+  }
+  return li;
+}
+
+static int g7_init(void)
+{
+  g7_rif();
+
+  if (BSP_LCD_Init(0, LCD_ORIENTATION_LANDSCAPE) != BSP_ERROR_NONE)
+  {
+    my_printf("# gate7: BSP_LCD_Init failed\r\n");
+    return 0;
+  }
+  BSP_LCD_LayerConfig_t cfg;
+  cfg.X0 = 0; cfg.X1 = G7_W;
+  cfg.Y0 = 0; cfg.Y1 = G7_H;
+  cfg.PixelFormat = LCD_PIXEL_FORMAT_RGB565;
+  cfg.Address     = G7_FB_ADDR;
+  if (BSP_LCD_ConfigLayer(0, LTDC_LAYER_1, &cfg) != BSP_ERROR_NONE)
+  {
+    my_printf("# gate7: BSP_LCD_ConfigLayer failed\r\n");
+    return 0;
+  }
+  UTIL_LCD_SetFuncDriver(&LCD_Driver);
+  UTIL_LCD_SetLayer(LTDC_LAYER_1);
+  UTIL_LCD_SetFont(&Font20);
+  UTIL_LCD_SetBackColor(UTIL_LCD_COLOR_BLACK);
+  UTIL_LCD_SetTextColor(UTIL_LCD_COLOR_WHITE);
+  UTIL_LCD_Clear(UTIL_LCD_COLOR_BLACK);
+  g7_flush();
+  g7_up = 1;
+  my_printf("# gate7: LCD up, %lux%lu RGB565 at %p, pixel clock %lu Hz\r\n",
+            (unsigned long)G7_W, (unsigned long)G7_H, (void *)G7_FB_ADDR,
+            (unsigned long)HAL_RCCEx_GetPeriphCLKFreq(RCC_PERIPHCLK_LTDC));
+  return 1;
+}
