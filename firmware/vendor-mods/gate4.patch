+#ifdef GATE4_CORPUS
+/* stm32n6-stt: multi-utterance device-vs-host comparison.
+ *
+ * Gate 4's execution question is closed (board/GATE4.md Round 19: 448 epochs,
+ * 124.0 ms, deterministic across two schedules). What is open is whether the
+ * device's int8 arithmetic is close enough to the host's, and one canned
+ * utterance cannot answer that -- 4 word errors in 17 words is a Wilson
+ * interval of [9.6 %, 47.3 %].
+ *
+ * So: a corpus of N feature tensors is flashed to external flash, and this loops
+ * over them printing the argmax ids for each. Scoring is host-side
+ * (firmware/test/score_corpus.py) -- the board's job is to report what it
+ * computed, not to judge it.
+ *
+ * The blob is NOT compiled in. 64 utterances is 4 MB of .rodata against a 1 MB
+ * RAM region that is already at 77 % with a single tensor, and this application
+ * is copied to RAM to run. It lives in external flash instead, memory-mapped by
+ * Ext_Mem_Config() exactly as the weight blob at 0x70400000 is, and is read from
+ * there directly. The weights end around 0x70D9C000, so 0x71000000 is clear.
+ *
+ * Layout, matching firmware/tools/gen_corpus.py:
+ *   0x00  "STTC"   0x04  uint32 N   0x08  uint32 T   0x0C  uint32 NMEL
+ *   0x40  N tensors of T*NMEL int8, mel-major, back to back
+ */
+#define GATE4_CORPUS_BASE 0x71000000u
+
+static void gate4_corpus(void)
+{
+  const volatile uint32_t *hdr = (const volatile uint32_t *)GATE4_CORPUS_BASE;
+  const uint32_t magic = hdr[0];
+  const uint32_t n_utt = hdr[1];
+  const uint32_t t_len = hdr[2];
+  const uint32_t n_mel = hdr[3];
+
+  my_printf("\r\n# gate4 corpus @ %p magic=%08lx N=%lu T=%lu NMEL=%lu\r\n",
+            (void *)GATE4_CORPUS_BASE, (unsigned long)magic,
+            (unsigned long)n_utt, (unsigned long)t_len, (unsigned long)n_mel);
+
+  /* "STTC" little-endian. A blank or mis-flashed slot reads 0xFFFFFFFF or 0, and
+   * silently scoring garbage would be worse than not running. */
+  if (magic != 0x43545453u)
+  {
+    my_printf("# corpus magic bad -- expected 43545453, flash the blob to %p\r\n",
+              (void *)GATE4_CORPUS_BASE);
+    return;
+  }
+
+  const uint32_t utt_bytes = t_len * n_mel;
+  if (utt_bytes != (uint32_t)STAI_NETWORK_IN_1_SIZE_BYTES)
+  {
+    my_printf("# corpus geometry %lu B != model input %d B -- refusing\r\n",
+              (unsigned long)utt_bytes, (int)STAI_NETWORK_IN_1_SIZE_BYTES);
+    return;
+  }
+
+  if (AiDPULoadModel(&g4_aictx) != DPU_OK)
+  {
+    my_printf("# gate4 corpus: AiDPULoadModel FAILED\r\n");
+    return;
+  }
+
+  int8_t *in  = (int8_t *) g4_aictx.p_stai_inputs[0];
+  int8_t *out = (int8_t *) g4_aictx.p_stai_outputs[0];
+  const uint32_t out_bytes = (uint32_t)STAI_NETWORK_OUT_1_SIZE_BYTES;
+  const uint32_t n_frames  = out_bytes / (uint32_t)CANNED_NVOCAB;
+
+  for (uint32_t pass = 0; ; pass++)
+  {
+    my_printf("\r\n# ---- corpus pass %lu ----\r\n", (unsigned long)pass);
+
+    for (uint32_t i = 0; i < n_utt; i++)
+    {
+      const int8_t *src = (const int8_t *)(GATE4_CORPUS_BASE + 0x40u + i * utt_bytes);
+      memcpy(in, src, utt_bytes);
+      mcu_cache_clean_invalidate_range((uint32_t)in, (uint32_t)in + utt_bytes);
+
+      port_dwt_reset();
+      uint32_t t0 = (uint32_t)port_dwt_get_cycles();
+      AiDPUProcess(&g4_aictx);
+      uint32_t cycles = (uint32_t)port_dwt_get_cycles() - t0;
+
+      /* the stock app never invalidates the output; the NPU writes it by another
+       * path and the M55 D-cache may hold stale lines. */
+      mcu_cache_invalidate_range((uint32_t)out, (uint32_t)out + out_bytes);
+
+      my_printf("# u %lu cyc %lu ids:", (unsigned long)i, (unsigned long)cycles);
+      for (uint32_t f = 0; f < n_frames; f++)
+      {
+        const int8_t *row = out + f * (uint32_t)CANNED_NVOCAB;
+        int8_t   best_v = row[0];
+        uint32_t best_i = 0;
+        for (uint32_t v = 1; v < (uint32_t)CANNED_NVOCAB; v++)
+        {
+          if (row[v] > best_v) { best_v = row[v]; best_i = v; }
+        }
+        my_printf(" %lu", (unsigned long)best_i);
+      }
+      my_printf("\r\n");
+    }
+
+    my_printf("# corpus done %lu utterances\r\n", (unsigned long)n_utt);
+    HAL_Delay(5000);
+  }
+}
+#endif /* GATE4_CORPUS */
