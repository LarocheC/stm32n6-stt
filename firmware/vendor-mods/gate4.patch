+  /* the stock app never invalidates the output; the NPU writes it by another
+   * path and the M55 D-cache may hold stale lines. */
+  mcu_cache_invalidate_range((uint32_t)out,
+                             (uint32_t)out + (uint32_t)CANNED_N_FRAMES * CANNED_NVOCAB);
+
+  my_printf("# invoke %lu cycles = %d.%03d ms at %lu Hz\r\n",
+            (unsigned long)cycles,
+            (int)((uint64_t)cycles * 1000u / port_hal_get_cpu_freq()),
+            (int)(((uint64_t)cycles * 1000000u / port_hal_get_cpu_freq()) % 1000u),
+            (unsigned long)port_hal_get_cpu_freq());
