+/* The banner is redrawn every time so the state colour is unambiguous across
+ * the room: green while the microphone is live, amber while the NPU runs. */
+static void g7_banner(const char *state, uint32_t colour)
+{
+  if (!g7_up) return;
+  UTIL_LCD_FillRect(0, 0, G7_W, 64u, UTIL_LCD_COLOR_ST_BLUE_DARK);
+  UTIL_LCD_SetBackColor(UTIL_LCD_COLOR_ST_BLUE_DARK);
+  UTIL_LCD_SetTextColor(UTIL_LCD_COLOR_WHITE);
+  g7_at(12u, 4u, "STM32N6570-DK   Citrinet-256 CTC   8 s window", LEFT_MODE);
+  UTIL_LCD_SetTextColor(colour);
+  g7_at(12u, 34u, state, LEFT_MODE);
+  UTIL_LCD_SetBackColor(UTIL_LCD_COLOR_BLACK);
+  UTIL_LCD_SetTextColor(UTIL_LCD_COLOR_WHITE);
+  g7_flush();
+}
+
+/* Live input meter, drawn during the 8 s capture from whatever has arrived so
+ * far. Every failure this project hit on live audio was a level or presence
+ * problem that stayed invisible until the UART log was read afterwards: a null
+ * run where nobody spoke, a capture at 1 dB SNR, 1067 clipped samples, 21 dB
+ * given away by a mis-targeted AGC. A bar costs nothing -- the capture loop is
+ * eight seconds of `while (g5m_arm) { __NOP(); }` -- and it makes all of them
+ * visible while they are happening.
+ *
+ * Scale is -60..0 dBFS. The tick marks the -15 dBFS AGC target; the last 3 dB
+ * are red, because clipping is the one failure the level sweep showed to be
+ * catastrophic rather than gradual (FRONTEND.md sections 12-13). */
+static void g7_meter(int dbfs_x10, uint32_t clipped)
+{
+  if (!g7_up) return;
+  const uint32_t X = 24u, W = 752u, Y = G7_SPEC_Y + 96u, H = 48u;
+  int d = dbfs_x10;
+  if (d < -600) d = -600;
+  if (d > 0)    d = 0;
+  uint32_t w = (uint32_t)(((int)W * (d + 600)) / 600);
+  const uint32_t red_x = (W * 570u) / 600u;            /* -3 dBFS */
+  const uint32_t tgt_x = (W * 450u) / 600u;            /* -15 dBFS */
+
+  g7_fill(X, Y, W, H, g7_rgb(16, 18, 24));
+  if (w)
+  {
+    const uint32_t lit = (w < red_x) ? w : red_x;
+    g7_fill(X, Y, lit, H, g7_rgb(40, 200, 90));
+    if (w > red_x) g7_fill(X + red_x, Y, w - red_x, H, g7_rgb(230, 60, 40));
+  }
+  g7_fill(X + tgt_x, Y - 6u, 2u, H + 12u, g7_rgb(255, 255, 255));
+  if (clipped) g7_fill(X + W - 40u, Y - 6u, 40u, H + 12u, g7_rgb(255, 0, 0));
+  g7_flush_rows(Y - 6u, H + 12u);
+}
+
+/* The 80 x 800 log-mel the front end just computed, on an ABSOLUTE scale.
+ * citrinet_fe_logmel() returns pass-1 values, ln(mel + 2^-24), before per-bin
+ * normalisation -- so the guard floor at ln(2^-24) = -16.64 renders as black
+ * instead of being normalised away. That is the whole point: guard occupancy,
+ * spectral tilt and whether the room is louder than the talker are all things
+ * FRONTEND.md sections 12-15 needed a recording and a laptop to see, and they
+ * are all legible here at a glance. One pixel per 10 ms frame, three rows per
+ * mel bin, bin 0 at the bottom. */
+static void g7_spectrogram(void)
+{
+  if (!g7_up) return;
+  uint16_t *fb = (uint16_t *)G7_FB_ADDR;
+  for (uint32_t b = 0; b < (uint32_t)CITRINET_FE_NMEL; b++)
+  {
+    const uint32_t y = G7_SPEC_Y + (uint32_t)(CITRINET_FE_NMEL - 1u - b) * G7_SPEC_PX;
+    uint16_t *r0 = fb + y * G7_W;
+    for (uint32_t t = 0; t < (uint32_t)CITRINET_FE_T; t++)
+    {
+      float v = citrinet_fe_logmel(&g5_fe, b, t);
+      /* CITRINET_FE_LOG_FLOOR .. +1, mapped to 0..255 */
+      float u = (v - (float)CITRINET_FE_LOG_FLOOR) / (1.0f - (float)CITRINET_FE_LOG_FLOOR);
+      if (u < 0.0f) u = 0.0f;
+      if (u > 1.0f) u = 1.0f;
+      const uint32_t k = (uint32_t)(u * 255.0f);
+      uint16_t c;
+      if      (k <  64u) c = g7_rgb(0, 0, k * 3u);
+      else if (k < 128u) c = g7_rgb(0, (k - 64u) * 4u, 192u + (k - 64u));
+      else if (k < 192u) c = g7_rgb((k - 128u) * 4u, 255u, 255u - (k - 128u) * 4u);
+      else               c = g7_rgb(255u, 255u, (k - 192u) * 4u);
+      r0[t]           = c;
+      r0[G7_W + t]    = c;
+      r0[2u * G7_W + t] = c;
+    }
+  }
+  g7_flush_rows(G7_SPEC_Y, G7_SPEC_H);
+}
+
+static void g7_transcript(const char *text, const char *stats, uint32_t colour)
+{
+  if (!g7_up) return;
+  UTIL_LCD_FillRect(0, 64u, G7_W, G7_SPEC_Y - 64u, UTIL_LCD_COLOR_BLACK);
+  UTIL_LCD_FillRect(0, G7_STATS_Y - 8u, G7_W, G7_H - G7_STATS_Y + 8u,
+                    UTIL_LCD_COLOR_BLACK);
+  UTIL_LCD_SetTextColor(colour);
+  if (text && text[0]) (void)g7_wrap(text, 12u, 72u, G7_MAXLINES);
+  else                 g7_at(12u, 72u, "(nothing decoded)", LEFT_MODE);
+  UTIL_LCD_SetTextColor(UTIL_LCD_COLOR_ST_GRAY);
+  if (stats) g7_at(12u, G7_STATS_Y, stats, LEFT_MODE);
+  UTIL_LCD_SetTextColor(UTIL_LCD_COLOR_WHITE);
+  g7_flush();
+}
+#endif /* GATE7_LCD */
