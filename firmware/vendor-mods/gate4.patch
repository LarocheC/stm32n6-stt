+   * looked like a measurement.  port_dwt_init_imp() has already run in init_bm(). */
+  port_dwt_reset();
+
+  my_printf("# invoking...\r\n");
+  BEACON('\r'); BEACON('\n'); BEACON('I');
+  uint32_t t0 = (uint32_t)port_dwt_get_cycles();
+  AiDPUProcess(&g4_aictx);
+  uint32_t cycles = (uint32_t)port_dwt_get_cycles() - t0;
+  BEACON('O');
+  my_printf("# invoke returned\r\n");
