+#ifdef GATE5_MIC
+/* stm32n6-stt: Gate 5 live capture -- the board's own microphone, end to end.
+ *
+ * GATE5_WAV proved waveform -> features -> NPU on silicon with the waveform
+ * coming out of external flash (board/traces/round21_wav_replay.log: front end
+ * 136 ms, NPU 140 ms).  This path replaces the flash with the DK's on-board
+ * MP23DB01HP PDM microphone through MDF1 -- the one link in the chain nobody
+ * has yet seen a single sample come out of.
+ *
+ * WHAT IS DELIBERATELY NOT REUSED.  ST's acquisition chain (initAudioCapture ->
+ * AudioCapture_ring_buff_alloc -> exec_bm's availableSamples poll) mallocs
+ * nbSamples*2*nbFrames = 513,280 B at COL 800 and would fail at runtime inside
+ * a while(1) (firmware/WORKLIST.md section 5.4).  The utterance-based design
+ * needs none of it: one 8 s buffer, filled once, then processed.  So this keeps
+ * BSP_AUDIO_IN_Record and the two BSP transfer callbacks and drops the ring
+ * buffer entirely -- the callbacks append straight into AXISRAM3.
+ *
+ * GAIN STAGING is the named unsolved risk (docs/FEASIBILITY.md section 2(d):
+ * gaining up AFTER the int16 truncation only recovers to 10.45 % WER, so the
+ * gain has to be applied before it).  There are two knobs and this measures
+ * both, on the same captured audio, every utterance:
+ *
+ *   1. MDF_GAIN, analogue-domain, applied BEFORE the truncation.  Range -16..24
+ *      in ~3 dB steps (stm32n6xx_hal_mdf.h:275-277).  Record_Init() leaves it at
+ *      MDF_GAIN(16000) = 2.  HAL_MDF_SetGain() only works while the filter is in
+ *      HAL_MDF_STATE_ACQUISITION (stm32n6xx_hal_mdf.c:1808), so it is called
+ *      after BSP_AUDIO_IN_Record(), not before.
+ *
+ *      THE AGC TARGETS PEAK LEVEL.  It briefly targeted guard occupancy instead,
+ *      and that was a mistake worth recording rather than deleting.
+ *
+ *      What is true: this board's microphone is not quiet.  At the stock gain of
+ *      2 it delivers a -3.8 dBFS peak with 0 clipped samples, against the -54
+ *      dBFS docs/FEASIBILITY.md section 2(d) assumed.  That premise is wrong by
+ *      about 50 dB and the gain deficit it predicted never existed.
+ *
+ *      What was NOT true: that the eval corpus sits at 35.6 % guard occupancy and
+ *      the AGC should drive live audio to match.  That 35.6 % is the RAW
+ *      guard_below count, and it is mostly ZERO PADDING -- the corpus window holds
+ *      2-8 s of speech in an 8 s window and the remainder is exact digital
+ *      silence, whose mel energy is exactly 0 and therefore below 2^-24.  The
+ *      corpus figure with those excluded -- which is what citrinet_fe.c's own
+ *      guard_fraction() tests against CITRINET_FE_GUARD_MAX_FRAC -- is 10.6 %.
+ *      A live capture fills all 128,000 samples with real audio and has no
+ *      padding, so the only way for it to reach 36 % is to push REAL SPEECH below
+ *      the guard.  The controller did exactly that: gain 2 -> -5, throwing away
+ *      21 dB.  Measured cost on canned material peak-scaled to those levels:
+ *      6.25 % WER at -3.8 dBFS and 5.56 % at -7.6, against 6.94 % at -19 and
+ *      8.33 % at -23.
+ *
+ *      And guard occupancy cannot be servo'd by gain in the first place: gain
+ *      scales speech and room noise together, leaving their ratio alone, while
+ *      moving both toward an ABSOLUTE floor at 2^-24.  It is a diagnostic and a
+ *      refusal criterion, not a setpoint.  Kept as both, printed every utterance.
+ *
+ *      So: target the peak, on a plateau.  Measured WER against peak level is
+ *      flat at 6-8 % from -3.8 down to -30 dBFS, 9.7 % at -40 and 18.1 % at -54,
+ *      and CITRINET_FE_GUARD_MAX_FRAC first fires at -30 dBFS, exactly where the
+ *      curve turns (firmware/test/level_sweep.py).
+ *
+ *      THE TARGET IS -15 dBFS, NOT THE CORPUS MEDIAN OF -7.6, AND CLIPPING GETS A
+ *      FAST ATTACK.  The costs either side of the plateau are wildly asymmetric.
+ *      Round 24 caught the stock gain of 2 clipping 1067 of 128,000 samples --
+ *      0.83 % -- on a louder talker, and that utterance scored 62.5 % WER, the
+ *      worst measured anywhere in this project.  Losing 9 dB of level, by
+ *      contrast, costs nothing measurable: the plateau is 26 dB wide.  So spend
+ *      level to buy headroom, and treat clipping as a different kind of event
+ *      rather than a large error:
+ *
+ *        - any clipped sample at all -> drop the maximum, -3 steps, immediately.
+ *          A clipped capture reads peak 0.0 dBFS, which against a -15 dBFS target
+ *          is only 5 steps; against the -7.6 target it was 2, and round 24 took
+ *          two utterances to escape.  Note 39 clipped samples was HARMLESS there
+ *          (0.0 % WER), so this triggers on existence, not severity -- headroom
+ *          is cheap and the failure is not.
+ *        - otherwise the ordinary deadbanded peak correction, at most 3 steps.
+ *
+ *      Peak is a noisy statistic -- round 24 saw the same sentence 12 s apart at
+ *      -5.0 and -12.2 dBFS -- so the deadband matters more than the setpoint.
+ *      The per-utterance magnitude histogram printed below is the raw material
+ *      for something better (an active-speech-level percentile) if it is needed.
+ *   2. citrinet_fe_peak_normalize(), digital, applied AFTER it.  This is the
+ *      knob FEASIBILITY says is the weak one -- so run it as the CONTROL, not
+ *      as the fix, and print both transcripts.  If "raw" and "norm" agree, the
+ *      analogue gain is already sufficient; if "norm" is much better, knob 1
+ *      has further to go; if "norm" is better than "raw" can ever get, that is
+ *      the truncation loss, measured rather than assumed.
+ *
+ * The instrument that matters is guard occupancy, not the transcript: a level
+ * too low shows up as mel energies below 2^-24 long before it shows up as
+ * wrong words (firmware/WORKLIST.md 5.9).  It is printed every utterance and
+ * citrinet_fe_run() returns CITRINET_FE_E_GUARD (-4) past 50 %.  The NPU runs
+ * anyway -- refusing would hide exactly the degradation we are here to see.
+ */
+#define G5M_TARGET_DBFS_X10   (-150)   /* see the note on headroom below         */
+#define G5M_STEP_DB_X10       30       /* one MDF gain step, ~3 dB              */
+#define G5M_GAIN_MIN          (-16)
+#define G5M_GAIN_MAX          24
+#define G5M_MAX_STEP          3        /* per utterance, so a wild reading cannot
+                                        * slam the gain to a rail in one go    */
+#define G5M_START_GAIN        2        /* MDF_GAIN(16000), the BSP default, which
+                                        * measured -3.8 dBFS peak and 0 clipped  */
+#define G5M_SETTLE_MS         400u     /* dropped: MDF high-pass + gain change  */
+
+/* Dump the captured waveform over the UART, once, as base64.
+ *
+ * Every explanation for the gap between 4.3 % WER on canned waveforms and ~30 %
+ * on this microphone has now been eliminated by measurement -- level, int16
+ * quantisation, additive noise at the SNR the board reports, and the front end
+ * itself -- which leaves the acoustic channel, and the cheapest way to judge an
+ * acoustic channel is to LISTEN to it.
+ *
+ * It has to come out of the firmware: STM32_Programmer_CLI cannot attach over
+ * SWD while the application runs (board/GATE3.md -- HOTPLUG does not work on
+ * this part), so the buffer at 0x34200000 is unreachable from the host.
+ *
+ * 128,000 samples of int16 is 256,000 B, which base64 expands to ~341 kB and the
+ * 14400-baud link takes about four minutes to shift. So this fires ONCE, on the
+ * first utterance that actually decodes something, rather than on every window.
+ * The FNV-1a at the end covers the raw bytes, so a dropped character during
+ * those four minutes is detected rather than silently written into a .wav. */
+#ifdef GATE7_PCM_DUMP
+static int g5m_dumped;
+
+static void g5m_dump_pcm(uint32_t utt, const int16_t *pcm)
+{
+  static const char B64[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  const uint8_t *p = (const uint8_t *)pcm;
+  const uint32_t n = (uint32_t)CITRINET_FE_NSAMPLES * 2u;
+
+  my_printf("# PCM BEGIN utt %lu samples %lu rate 16000 fmt s16le enc b64\r\n",
+            (unsigned long)utt, (unsigned long)CITRINET_FE_NSAMPLES);
+  uint32_t col = 0;
+  for (uint32_t i = 0; i < n; i += 3u)
+  {
+    const uint32_t b0 = p[i];
+    const uint32_t b1 = (i + 1u < n) ? p[i + 1u] : 0u;
+    const uint32_t b2 = (i + 2u < n) ? p[i + 2u] : 0u;
+    const uint32_t v  = (b0 << 16) | (b1 << 8) | b2;
+    my_printf("%c%c%c%c", B64[(v >> 18) & 63u], B64[(v >> 12) & 63u],
+              (i + 1u < n) ? B64[(v >> 6) & 63u] : '=',
+              (i + 2u < n) ? B64[v & 63u]        : '=');
+    col += 4u;
+    if (col >= 76u) { my_printf("\r\n"); col = 0u; }
+  }
+  if (col) my_printf("\r\n");
+  my_printf("# PCM END utt %lu fnv1a ", (unsigned long)utt);
+  g5_hex8(g5_fnv1a(p, n));
+  my_printf("\r\n");
+}
+#endif /* GATE7_PCM_DUMP */
+
+/* Gate 7b -- push to talk.
+ *
+ * BSP_PB_Init(BUTTON_USER1, BUTTON_MODE_EXTI) configures GPIO_PULLDOWN with
+ * GPIO_MODE_IT_FALLING (stm32n6570_discovery.c), which is self-contradictory for
+ * an active-high button, so neither the pull nor the edge is worth trusting.
+ * Sample the resting level once at start-up and call "pressed" whatever differs
+ * from it. That is immune to the polarity question and needs no schematic.
+ *
+ * Polled, not interrupt-driven: hold-to-talk needs a level, not an edge, and the
+ * loop has nothing else to do. */
+#define G5M_DEBOUNCE_MS   20u
+#define G5M_MIN_HOLD_MS  400u
+
+static uint32_t g5m_btn_idle;
+
+static int g5m_btn_raw(void)
+{
+  return (int)BSP_PB_GetState(BUTTON_USER1);
+}
+
+static int g5m_btn_down(void)
+{
+  const int a = g5m_btn_raw();
+  HAL_Delay(G5M_DEBOUNCE_MS);
+  return (a == g5m_btn_raw()) ? (a != (int)g5m_btn_idle) : 0;
+}
+
+static volatile uint32_t g5m_w;        /* samples written, 0..CITRINET_FE_NSAMPLES */
+static volatile int      g5m_arm;      /* 1 while the callbacks should append   */
+static char              g5m_text[CITRINET_CTC_TEXT_CAP];
+
+/* Called from the BSP transfer callbacks, i.e. from GPDMA1_Channel0_IRQHandler
+ * by way of BSP_AUDIO_IN_IRQHandler.  160 samples per call, one call every
+ * 10 ms.  Writes are CPU writes to AXISRAM3 and reads are CPU reads, so there
+ * is no coherency problem to solve here. */
+void gate5_mic_feed(const int16_t *src, uint32_t n)
+{
+  if (!g5m_arm) return;
+  uint32_t w = g5m_w;
+  const uint32_t room = (uint32_t)CITRINET_FE_NSAMPLES - w;
+  if (n > room) n = room;
+  memcpy((int16_t *)GATE5_PCM_RAM + w, src, n * sizeof(int16_t));
+  w += n;
+  g5m_w = w;
+  if (w >= (uint32_t)CITRINET_FE_NSAMPLES) g5m_arm = 0;
+}
+
+/* dBFS x10 of a magnitude in int16 counts.  -999 stands for digital silence. */
+static int g5m_dbfs_x10(uint32_t v)
+{
+  if (v == 0u) return -999;
+  return (int)lrintf(200.0f * log10f((float)v / 32768.0f));
+}
+
+static void g5m_print_dbfs(int x10)
+{
+  if (x10 == -999) { my_printf("-inf"); return; }
+  const int a = x10 < 0 ? -x10 : x10;
+  my_printf("%s%d.%d", x10 < 0 ? "-" : "", a / 10, a % 10);
+}
+
+typedef struct { int rc; uint32_t guard_pct; uint32_t nchars;
+                 uint32_t fe_cy; uint32_t npu_cy; } g5m_res_t;
+
+/* Front end + NPU + CTC over whatever is in `pcm`, reported under `tag`. */
+static g5m_res_t g5m_infer(uint32_t utt, const char *tag, const int16_t *pcm,
+                           int rowhash)
+{
+  int8_t *in  = (int8_t *) g4_aictx.p_stai_inputs[0];
+  int8_t *out = (int8_t *) g4_aictx.p_stai_outputs[0];
+  const uint32_t in_bytes  = (uint32_t)STAI_NETWORK_IN_1_SIZE_BYTES;
+  const uint32_t out_bytes = (uint32_t)STAI_NETWORK_OUT_1_SIZE_BYTES;
+  const uint32_t n_frames  = out_bytes / (uint32_t)CANNED_NVOCAB;
+  const float    q_scale   = 1.0f / g4_aictx.input_Q_inv_scale;
+
+  port_dwt_reset();
+  const uint32_t t0 = (uint32_t)port_dwt_get_cycles();
+  const int rc = citrinet_fe_run(&g5_fe, pcm, (uint32_t)CITRINET_FE_NSAMPLES,
+                                 q_scale, 0, in);
+  const uint32_t t1 = (uint32_t)port_dwt_get_cycles();
+
+  /* before the invoke: input and output buffers may alias (GATE4.md Round 1) */
+  const uint32_t fhash = g5_fnv1a((const uint8_t *)in, in_bytes);
+  if (rowhash) { g5_print_row_hashes(in, utt, tag);
+                 g5_print_row_sums(in, utt, tag); }
+
+  mcu_cache_clean_invalidate_range((uint32_t)in, (uint32_t)in + in_bytes);
+
+  port_dwt_reset();                    /* AiDPUProcess() resets it internally */
+  const uint32_t n0 = (uint32_t)port_dwt_get_cycles();
+  AiDPUProcess(&g4_aictx);
+  const uint32_t n1 = (uint32_t)port_dwt_get_cycles();
+
+  mcu_cache_invalidate_range((uint32_t)out, (uint32_t)out + out_bytes);
+
+  const uint32_t guard_tot = (uint32_t)CITRINET_FE_NMEL * (uint32_t)CITRINET_FE_T;
+  my_printf("# m %lu %s fe %lu npu %lu rc %d guard %lu/%lu (%lu%%) hash ",
+            (unsigned long)utt, tag, (unsigned long)(t1 - t0),
+            (unsigned long)(n1 - n0), rc,
+            (unsigned long)g5_fe.guard_below, (unsigned long)guard_tot,
+            (unsigned long)((g5_fe.guard_below * 100u) / guard_tot));
+  g5_hex8(fhash);
+  my_printf(" ids:");
+  for (uint32_t f = 0; f < n_frames; f++)
+  {
+    const int8_t *row = out + f * (uint32_t)CANNED_NVOCAB;
+    int8_t   best_v = row[0];
+    uint32_t best_i = 0;
+    for (uint32_t v = 1; v < (uint32_t)CANNED_NVOCAB; v++)
+      if (row[v] > best_v) { best_v = row[v]; best_i = v; }
+    my_printf(" %lu", (unsigned long)best_i);
+  }
+  my_printf("\r\n");
+
+  uint32_t nw = 0;
+  const citrinet_ctc_status_t st =
+      citrinet_ctc_decode(out, n_frames, g5m_text, sizeof(g5m_text), &nw, NULL);
+  my_printf("# T %lu %s ctc %d chars %lu \"%s\"\r\n",
+            (unsigned long)utt, tag, (int)st, (unsigned long)nw, g5m_text);
+
+  g5m_res_t r;
+  r.rc        = rc;
+  r.guard_pct = (g5_fe.guard_below * 100u) / guard_tot;
+  r.nchars    = nw;
+  r.fe_cy     = t1 - t0;
+  r.npu_cy    = n1 - n0;
+  return r;
+}
+
+static void gate5_mic(void)
+{
+  int gain = G5M_START_GAIN;
+
+  my_printf("\r\n# gate5 mic: on-board MP23DB01HP -> MDF1 filter0, 16 kHz mono int16\r\n");
+  my_printf("# fe backend=%d tables_fnv1a=%08lx window %d samples (%d s)\r\n",
+            citrinet_fe_backend(), (unsigned long)citrinet_fe_tables_fnv1a(),
+            (int)CITRINET_FE_NSAMPLES,
+            (int)(CITRINET_FE_NSAMPLES / CITRINET_FE_SR));
+
+  if (!g5_init_common("gate5 mic")) return;
+
+  BSP_LED_Init(LED_GREEN);
+  BSP_LED_Off(LED_GREEN);
+
+  /* Record_Init() FIRST, and that ordering is load-bearing. PLL4 is shared:
+   * MX_MDF1_ClockConfig() reprograms it (at 16 kHz to 1376/28 = 49.142 MHz,
+   * Patch/stm32n6570_discovery_audio.patch.hsi_600_400.c:65-67) and
+   * MX_LTDC_ClockConfig() derives the pixel clock from whatever it finds there,
+   * as IC16 = PLL4 / 2 (stm32n6570_discovery_lcd.c:434-435). 49.142 / 2 =
+   * 24.57 MHz, within 2 % of the 25 MHz the panel wants -- a coincidence, but a
+   * usable one. Bringing the LCD up first would set the pixel clock from a PLL4
+   * that the audio path then moves out from under it. */
+  Record_Init();
+#ifdef GATE7_LCD
+  (void)g7_init();
+  g7_banner("STARTING", UTIL_LCD_COLOR_ST_GRAY_LIGHT);
+  g7_transcript("", "waiting for the first utterance", UTIL_LCD_COLOR_ST_GRAY);
+#endif
+
+  /* The microphone now runs CONTINUOUSLY and arming only gates the appender.
+   * The old per-utterance Record/Stop cycle needed a 400 ms settle for the MDF
+   * high-pass and the gain change, which under push-to-talk would swallow the
+   * first 400 ms of every utterance. Running the filter forever removes the
+   * settle entirely, and HAL_MDF_SetGain() wants HAL_MDF_STATE_ACQUISITION
+   * anyway, which is now always true. */
+  g5m_arm = 0;
+  g5m_w   = 0;
+  if (BSP_ERROR_NONE != BSP_AUDIO_IN_Record(1, (uint8_t *)audio_acq_ctx.acq_buf,
+                                            CAPTURE_BUFFER_SIZE * sizeof(int16_t)))
+  {
+    my_printf("# BSP_AUDIO_IN_Record failed -- stopping\r\n");
+    return;
+  }
+  HAL_Delay(G5M_SETTLE_MS);
+  if (HAL_OK != HAL_MDF_SetGain(&haudio_in_mdf, gain))
+    my_printf("# HAL_MDF_SetGain(%d) refused\r\n", gain);
+
+  BSP_PB_Init(BUTTON_USER1, BUTTON_MODE_GPIO);
+  g5m_btn_idle = BSP_PB_GetState(BUTTON_USER1);
+  my_printf("# gate7b: USER1 resting level %lu; pressed = the other one\r\n",
+            (unsigned long)g5m_btn_idle);
+
+  int16_t *const pcm = (int16_t *)GATE5_PCM_RAM;
+
+  for (uint32_t utt = 0; ; utt++)
+  {
+    my_printf("\r\n# ---- utterance %lu, MDF gain %d: hold USER1 ----\r\n",
+              (unsigned long)utt, gain);
+#ifdef GATE7_LCD
+    g7_banner("HOLD USER1 TO TALK", UTIL_LCD_COLOR_ST_GRAY_LIGHT);
+#endif
+    while (!g5m_btn_down()) { }
+
+    g5m_w   = 0;
+    g5m_arm = 1;
+#ifdef GATE7_LCD
+    g7_banner("LISTENING  --  speak now", UTIL_LCD_COLOR_ST_GREEN_LIGHT);
+    g7_fill(0, G7_SPEC_Y, G7_W, G7_SPEC_H, g7_rgb(0, 0, 0));
+    g7_flush_rows(G7_SPEC_Y, G7_SPEC_H);
+#endif
+    BSP_LED_On(LED_GREEN);
+    const uint32_t t_press = HAL_GetTick();
+    my_printf("# >>> RECORDING, release USER1 to stop (max %d s)\r\n",
+              (int)(CITRINET_FE_NSAMPLES / CITRINET_FE_SR));
+#ifdef GATE7_LCD
+    /* The wait loop was eight seconds of __NOP(). Spend them on the meter: peak
+     * over each 100 ms of newly arrived samples, read from g5m_w without
+     * touching the interrupt path. */
+    {
+      uint32_t last = 0u, clip_seen = 0u;
+      while (g5m_arm)
+      {
+        if (g5m_btn_raw() == (int)g5m_btn_idle &&
+            (HAL_GetTick() - t_press) > G5M_MIN_HOLD_MS)
+        {
+          g5m_arm = 0;                    /* released: stop early */
+          break;
+        }
+        const uint32_t w = g5m_w;
+        if (w - last >= 1600u)
+        {
+          uint32_t pk = 0u;
+          for (uint32_t i = last; i < w; i++)
+          {
+            const int32_t  v = (int32_t)pcm[i];
+            const uint32_t a = (uint32_t)(v < 0 ? -v : v);
+            if (a > pk) pk = a;
+            if (a >= 32767u) clip_seen = 1u;
+          }
+          g7_meter(g5m_dbfs_x10(pk), clip_seen);
+          last = w;
+        }
+      }
+    }
+#else
+    while (g5m_arm)
+    {
+      if (g5m_btn_raw() == (int)g5m_btn_idle &&
+          (HAL_GetTick() - t_press) > G5M_MIN_HOLD_MS) { g5m_arm = 0; break; }
+    }
+#endif
+    g5m_arm = 0;
+    BSP_LED_Off(LED_GREEN);
+#ifdef GATE7_LCD
+    g7_banner("PROCESSING", UTIL_LCD_COLOR_ST_YELLOW);
+#endif
+    /* Zero-fill the tail. This is not merely tidy: it makes a live capture look
+     * like the evaluation corpus, whose 8 s windows hold 2-8 s of speech and
+     * exact digital silence after (FRONTEND.md section 12). The old free-running
+     * loop filled all 128,000 samples with room noise, which is a distribution
+     * the model never saw in training. */
+    const uint32_t n_spoken = g5m_w;
+    for (uint32_t i = n_spoken; i < (uint32_t)CITRINET_FE_NSAMPLES; i++) pcm[i] = 0;
+    my_printf("# <<< captured %lu samples (%lu.%02lu s), tail zero-filled\r\n",
+              (unsigned long)n_spoken,
+              (unsigned long)(n_spoken / CITRINET_FE_SR),
+              (unsigned long)((n_spoken % CITRINET_FE_SR) * 100u / CITRINET_FE_SR));
+    /* wait for release before the next prompt, so one long press is one take */
+    while (g5m_btn_raw() != (int)g5m_btn_idle) { }
+
+    /* ---- level, the number the whole gate turns on --------------------- */
+    uint32_t peak = 0, clip = 0;
+    double   acc  = 0.0;
+    const uint32_t n_lvl = n_spoken ? n_spoken : 1u;   /* the zero tail is not signal */
+    for (uint32_t i = 0; i < n_lvl; i++)
+    {
+      const int32_t  v = (int32_t)pcm[i];
+      const uint32_t a = (uint32_t)(v < 0 ? -v : v);
+      if (a > peak) peak = a;
+      if (a >= 32767u) clip++;
+      acc += (double)v * (double)v;
+    }
+    const uint32_t rms = (uint32_t)sqrt(acc / (double)n_lvl);
+
+    /* Magnitude histogram, one bin per octave: h[0] counts exact zeros, h[k]
+     * counts 2^(k-1) <= |x| < 2^k.  Two questions it answers that peak and RMS
+     * cannot.  Where is the noise floor -- if the low bins are empty the capture
+     * is quantisation-limited, and if they are populated it is self-dithered, so
+     * this is the direct test for the int16 quantisation noise that
+     * firmware/test/level_sweep.py could only rule out on canned material.  And
+     * what is the active speech level -- a high percentile read off the
+     * cumulative counts is robust to the single transients that make `peak` jump
+     * 7 dB between identical utterances. */
+    uint32_t hist[17];
+    for (uint32_t k = 0; k < 17u; k++) hist[k] = 0u;
+    for (uint32_t i = 0; i < n_lvl; i++)
+    {
+      const int32_t  v = (int32_t)pcm[i];
+      const uint32_t a = (uint32_t)(v < 0 ? -v : v);
+      hist[a == 0u ? 0u : (32u - __CLZ(a))]++;
+    }
+    my_printf("# H %lu", (unsigned long)utt);
+    for (uint32_t k = 0; k < 17u; k++) my_printf(" %lu", (unsigned long)hist[k]);
+    my_printf("\r\n");
+    my_printf("# L %lu peak %lu (", (unsigned long)utt, (unsigned long)peak);
+    g5m_print_dbfs(g5m_dbfs_x10(peak));
+    my_printf(" dBFS) rms %lu (", (unsigned long)rms);
+    g5m_print_dbfs(g5m_dbfs_x10(rms));
+    my_printf(" dBFS) clipped %lu gain %d\r\n", (unsigned long)clip, gain);
+
+    /* ---- knob 2 as the control, knob 1 as the fix ---------------------- */
+    const g5m_res_t raw = g5m_infer(utt, "raw", pcm, 1);
+#ifdef GATE7_LCD
+    {
+      /* g5m_text still holds the raw pass's transcript -- the raw pass is what a
+       * product would ship; peak_normalize is a diagnostic control (section 12). */
+      static char g7_stats[G7_COLS + 1u];
+      const int pdb = g5m_dbfs_x10(peak);
+      snprintf(g7_stats, sizeof g7_stats,
+               "fe %lums npu %lums  %d.%ddBFS  guard %lu%%  gain %d%s",
+               (unsigned long)(raw.fe_cy / 600000u),
+               (unsigned long)(raw.npu_cy / 600000u),
+               pdb / 10, (pdb < 0 ? -pdb : pdb) % 10,
+               (unsigned long)raw.guard_pct, gain,
+               clip > 0u ? "  CLIP" : "");
+      g7_transcript(g5m_text, g7_stats,
+                    raw.rc == 0 ? UTIL_LCD_COLOR_WHITE : UTIL_LCD_COLOR_ST_YELLOW);
+      g7_spectrogram();
+      g7_banner(raw.nchars ? "RESULT" : "NO SPEECH",
+                raw.nchars ? UTIL_LCD_COLOR_WHITE : UTIL_LCD_COLOR_ST_GRAY);
+    }
+#endif
+
+    const float dg = citrinet_fe_peak_normalize(pcm, (uint32_t)CITRINET_FE_NSAMPLES,
+                                                0.5f, 64.0f);
+    my_printf("# N %lu digital gain x%d/100\r\n",
+              (unsigned long)utt, (int)lrintf(dg * 100.0f));
+    (void)g5m_infer(utt, "norm", pcm, 0);
+
+    /* ---- one waveform to the host, so a human can listen to it ----------
+     * OPT-IN. Base64 over a 14400-baud link is ~12 minutes for one 8 s window
+     * (my_printf emits an ANSI reset per call, so the real overhead is 3.05x the
+     * payload), during which the board does nothing else. It answered its
+     * question in round 27 -- FRONTEND.md section 15 -- so it is off unless
+     * asked for. */
+#ifdef GATE7_PCM_DUMP
+    if (!g5m_dumped && raw.nchars > 0u)
+    {
+      g5m_dump_pcm(utt, pcm);
+      g5m_dumped = 1;
+    }
+#endif
+
+    /* ---- AGC for the next utterance ------------------------------------ */
+    /* Frozen when nothing was said.  Utterances 11-25 of the first silicon run
+     * were an empty room, and a guard-seeking loop with no speech gate winds the
+     * gain to a rail chasing a target that silence can never hit.  The decoder
+     * already tells us: no tokens, no adaptation. */
+    if (raw.nchars == 0u)
+    {
+      my_printf("# G %lu no speech decoded -- gain held at %d\r\n",
+                (unsigned long)utt, gain);
+    }
+    else if (peak > 0u)
+    {
+      /* peak below target => too quiet => raise gain.  Integer division is the
+       * deadband: anything inside +-3 dB, one step, leaves the gain alone.
+       * Clipping bypasses all of it -- see the header note. */
+      int steps = clip > 0u
+                ? -G5M_MAX_STEP
+                : (G5M_TARGET_DBFS_X10 - g5m_dbfs_x10(peak)) / G5M_STEP_DB_X10;
+      if (steps >  G5M_MAX_STEP) steps =  G5M_MAX_STEP;
+      if (steps < -G5M_MAX_STEP) steps = -G5M_MAX_STEP;
+      int ng = gain + steps;
+      if (ng < G5M_GAIN_MIN) ng = G5M_GAIN_MIN;
+      if (ng > G5M_GAIN_MAX) ng = G5M_GAIN_MAX;
+      my_printf("# G %lu peak ", (unsigned long)utt);
+      g5m_print_dbfs(g5m_dbfs_x10(peak));
+      my_printf(" target ");
+      g5m_print_dbfs(G5M_TARGET_DBFS_X10);
+      my_printf(" dBFS  guard %lu%% (diagnostic)%s  gain %d -> %d\r\n",
+                (unsigned long)raw.guard_pct,
+                clip > 0u ? "  CLIPPED: fast attack" : "", gain, ng);
+      if (ng != gain && HAL_OK != HAL_MDF_SetGain(&haudio_in_mdf, ng))
+        my_printf("# HAL_MDF_SetGain(%d) refused\r\n", ng);
+      gain = ng;
+    }
+
+  }
+}
